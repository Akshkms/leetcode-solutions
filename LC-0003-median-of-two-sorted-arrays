class Solution:
    def findMedianSortedArrays(self, nums1: List[int], nums2: List[int]) -> float:
        p1 = 0
        p2 = 0
        num = []
        while p1 < len(nums1) and p2 < len(nums2):
            if p1 < len(nums1):
                if nums1[p1] < nums2[p2]:
                    num.append(nums1[p1])
                    p1 += 1
                else:
                    if p2 < len(nums2):
                        num.append(nums2[p2])
                        p2 += 1
        num.extend(nums1[p1:])
        num.extend(nums2[p2:])
        leng = len(num)
        m = leng // 2
        m1 = m -1
        m2 = m1 + 1
        if leng % 2 == 0:
            result = (num[m1] + num[m2]) /2 
        else:
            result = num[m]
        return result
